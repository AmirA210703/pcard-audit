# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#     chmod 600 .env          # readable only by you
#
# `.env` is listed in .gitignore, so it is never committed. This file is the
# only one that gets committed, and it must never contain a real key.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Model provider for the "Ask the data" tab. Set ONE of the two keys below.
# The prohibited-purchase dashboard works without any key.
# ---------------------------------------------------------------------------

# Option A - Gemini (has a free tier): https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza-REPLACE-ME

# Option B - Claude (paid): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Only needed if both keys are set: "gemini" or "anthropic".
# AI_PROVIDER=gemini

# Path to the P-card SQLite database.
PCARD_DB=../pcards.db

# Optional: only needed if your key is NOT scoped to a single workspace.
# Find the ID under Settings -> Workspaces in the Console.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional: which model writes the SQL.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_MODEL=gemini-3.5-flash-lite

# Local server binding.
PORT=5000
HOST=127.0.0.1
